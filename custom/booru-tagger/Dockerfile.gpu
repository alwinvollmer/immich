FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

# ONNX_MODE=cpu: head detection + CCIP (imgutils) on the CPU — their varying input sizes would
# grow the CUDA arena; only pixai runs on the GPU (with an arena limit, see pixai10.py)

ENV DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/model-cache \
    IMGUTILS_HOME=/model-cache \
    TAGGER_DEVICE=gpu \
    ONNX_MODE=cpu

RUN apt-get update && \
    apt-get install -y python3 python3-pip libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir \
        "dghs-imgutils==0.19.0" \
        "onnxruntime-gpu>=1.19.0,<1.23" \
        fastapi \
        "uvicorn[standard]" \
        python-multipart \
        pillow

COPY app.py pixai10.py characters.py ./

EXPOSE 7860
CMD ["python3", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "7860"]
